# Database
DB_FILE=smarthome.db

# The Things Network (TTN)
# Host-side tools reach the local Things Stack here. Docker Compose overrides
# this with http://host.docker.internal:1885 inside the application container.
TTN_BASE_URL=http://localhost:1885
TTN_APP_ID=smart-building-lora-2
TTN_API_KEY=your-local-ttn-api-key
JOIN_EUI=0000000000000000
# Shared by every node in this deployment. DevEUI remains unique per ESP32.
LORAWAN_APP_KEY=replace-with-the-shared-32-hex-character-key
LORAWAN_FREQUENCY_PLAN_ID=EU_863_870_TTN
LORAWAN_VERSION=MAC_V1_0_3
LORAWAN_PHY_VERSION=PHY_V1_0_3_REV_A
# REQUIRED. The /ttn-webhook endpoint rejects every request with 503
# while this is empty. Set the same value in the TTN webhook's
# X-Webhook-Secret header.
TTN_WEBHOOK_SECRET=

# ThingsBoard
THINGSBOARD_URL=http://localhost:8080
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=your-thingsboard-password

# Email alerts
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_TO=alerts@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Authentication
ADMIN_EMAIL=admin@system.local
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_TTL_SECONDS=28800
PASSWORD_PBKDF2_ITERATIONS=200000
COOKIE_SECURE=false

# Development
LOCAL_TEST_MODE=false
# Comma-separated front-end origins allowed to call this API from a
# browser, e.g. https://portal.example.com. Empty means same-origin
# only (no cross-origin access).
CORS_ORIGINS=
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=86400

# Docker build only. On a network that intercepts TLS, export the proxy root
# certificate (DER) to .docker-local-ca.cer and point this at it. Leave unset
# on an ordinary network.
# SBMS_LOCAL_CA_FILE=.docker-local-ca.cer
