# Generate .env.building and deploy/stack/ttn-lw-stack.yml with:
# python tools/prepare_building.py --host 192.168.10.20 --admin-email admin@example.com
# Always use --env-file .env.building -f docker-compose.building.yml.
COMPOSE_PROJECT_NAME=pulse-building
SBMS_IMAGE=ghcr.io/0xkhedr/pulse-premises:latest
SBMS_BIND_ADDRESS=0.0.0.0
SBMS_HTTP_PORT=8000
TTS_IMAGE=thethingsnetwork/lorawan-stack:3.36.2
TTS_HOST=replace-with-building-server-ip-or-dns
TTS_POSTGRES_PASSWORD=replace-with-random-hex
TTS_CONSOLE_SECRET=replace-with-random-hex
TTS_COOKIE_BLOCK_KEY=replace-with-64-hex-characters
TTS_COOKIE_HASH_KEY=replace-with-128-hex-characters
TTS_CLUSTER_KEY=replace-with-32-hex-characters

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
PASSWORD_PBKDF2_ITERATIONS=200000
CORS_ORIGINS=
LOCAL_TEST_MODE=false
PREVIEW_MODE=false

TTN_APP_ID=smart-building-lora-2
TTN_API_KEY=
TTN_WEBHOOK_SECRET=replace-with-random-hex
TTN_CLUSTER_ADDRESS=localhost
JOIN_EUI=0000000000000000
LORAWAN_APP_KEY=replace-with-32-hex-characters
LORAWAN_FREQUENCY_PLAN_ID=EU_863_870_TTN
LORAWAN_VERSION=MAC_V1_0_3
LORAWAN_PHY_VERSION=PHY_V1_0_3_REV_A
AUTO_ENROLLMENT_ENABLED=false
AUTO_ENROLLMENT_GATEWAY_API_KEY=
AUTO_ENROLLMENT_GATEWAY_IDS=
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=86400

# Optional: enable only when a separate ThingsBoard server is available.
THINGSBOARD_ENABLED=false
THINGSBOARD_URL=
TB_USERNAME=
TB_PASSWORD=

ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=
SMTP_SERVER=
SMTP_PORT=587
