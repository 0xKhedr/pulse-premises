# Example values only: the IP, passwords, and cryptographic keys below are samples.
# Generate .env.building with fresh secrets and deploy/stack/ttn-lw-stack.yml with:
# python tools/prepare_building.py --host 192.168.10.20 --admin-email admin@building.example
# Replace the host and email in that command with your building's values.
# Always use --env-file .env.building -f docker-compose.building.yml.
COMPOSE_PROJECT_NAME=pulse-building
# SBMS is built from this repository's Dockerfile. No published app image is needed.
# For a network with a managed CA, set SBMS_LOCAL_CA_FILE=.docker-local-ca.cer.
# The CA file path is local to the machine performing the Docker build.
# 0.0.0.0 works on any server. A specific bind IP must belong to that server.
SBMS_BIND_ADDRESS=0.0.0.0
# Choose a free host port; update browser URLs if this changes.
SBMS_HTTP_PORT=8000
TTS_IMAGE=thethingsnetwork/lorawan-stack:3.36.2
# Host-specific: use the server's LAN IPv4 address or DNS name, without a port.
# This must match the public URLs in deploy/stack/ttn-lw-stack.yml.
TTS_HOST=192.168.10.20
# Sample credentials below have valid formats but are public examples.
# The generator replaces them with random values. Preserve actual existing secrets.
TTS_POSTGRES_PASSWORD=root
TTS_CONSOLE_SECRET=admin
TTS_COOKIE_BLOCK_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
TTS_COOKIE_HASH_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f
TTS_CLUSTER_KEY=0123456789abcdef0123456789abcdef

ADMIN_EMAIL=admin@building.example
ADMIN_PASSWORD=admin
# Depends on HTTPS configuration: true for HTTPS, false for the default LAN HTTP.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
PASSWORD_PBKDF2_ITERATIONS=200000
# Deployment-specific browser origins, including scheme and port; empty is same-origin.
CORS_ORIGINS=
LOCAL_TEST_MODE=false
PREVIEW_MODE=false

# Repo default in app/config.py and tools/configure_local_ttn.py.
# Keep this ID for existing firmware: it also determines the derived DevEUI namespace.
TTN_APP_ID=smart-building-lora-2
# These must belong to the bundled stack/application and its webhook configuration.
# An API key from another TTN installation will not authenticate against this stack.
# Create TTN_API_KEY in the stack after initialization; no usable key is in the repo.
TTN_API_KEY=
TTN_WEBHOOK_SECRET=example-webhook-secret-change-before-use
# Internal TTN cluster identity: localhost is intentional, not the host machine IP.
# SBMS reaches TTN at http://stack:1885, set by docker-compose.building.yml.
TTN_CLUSTER_ADDRESS=localhost
# JoinEUI matches firmware/lorawan_credentials.example.h (all zero bytes).
# The sample AppKey below is illustrative; no actual sensor key was found in the repo.
# Match deployed firmware for existing sensors, or flash new sensors with generated keys.
JOIN_EUI=0000000000000000
LORAWAN_APP_KEY=00112233445566778899AABBCCDDEEFF
# EU868 matches the LilyGO/ESP32-CAM firmware; protocol versions use app/config.py defaults.
LORAWAN_FREQUENCY_PLAN_ID=EU_863_870_TTN
LORAWAN_VERSION=MAC_V1_0_3
LORAWAN_PHY_VERSION=PHY_V1_0_3_REV_A
AUTO_ENROLLMENT_ENABLED=false
# Optional: mint a gateway traffic API key and list registered gateway IDs when enabled.
# Leave these empty until your actual gateway has been configured.
AUTO_ENROLLMENT_GATEWAY_API_KEY=
AUTO_ENROLLMENT_GATEWAY_IDS=
DEVICE_STALE_AFTER_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=86400

# Optional: enable only when a separate ThingsBoard server is available.
THINGSBOARD_ENABLED=false
# Example external hostname: replace if enabling this integration.
# Use an address reachable from SBMS's container. localhost points to SBMS itself.
THINGSBOARD_URL=http://thingsboard.example.com:8080
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=example-thingsboard-password-change-before-use

ALERT_EMAIL_ENABLED=false
# Sample addresses; supply your mailbox/app password before enabling alerts.
# SMTP server and port match .env.example; use your mail provider's settings.
ALERT_EMAIL_FROM=sbms@example.com
ALERT_EMAIL_PASSWORD=example-smtp-app-password-change-before-use
ALERT_EMAIL_TO=alerts@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
