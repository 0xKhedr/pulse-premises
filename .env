# Shared secret for the TTN webhook. The /ttn-webhook endpoint fails closed:
# while this is empty every uplink is rejected with 503. The identical value
# must be set as the X-Webhook-Secret header on the TTN webhook integration.
TTN_WEBHOOK_SECRET=bzBQ_P2TBZUD6fXeKj2-e__9oYPsf6j9yXNq0PRiwZg

# This network intercepts TLS, so the Docker build needs the GUCCA root
# certificate. Leave unset (or point at .docker-local-ca.cer.example) on a
# normal network.
SBMS_LOCAL_CA_FILE=.docker-local-ca.cer

# Over-the-air enrollment: register an unknown DevEUI in TTN once its join
# request proves it holds LORAWAN_APP_KEY. Inert until an admin opens a
# window at POST /admin/enrollment/open, and a restart closes any window.
# This stack identifies its own servers as 'localhost' even though the
# container reaches it at host.docker.internal:1885.
TTN_CLUSTER_ADDRESS=localhost

AUTO_ENROLLMENT_ENABLED=true
# Gateway traffic events need RIGHT_GATEWAY_TRAFFIC_READ. Left blank so it
# falls back to TTN_API_KEY, which is currently user-scoped and has it.
AUTO_ENROLLMENT_GATEWAY_API_KEY=NNSXS.SOOZE6WUDPC4A3UPTV4XJFSDALT4ZU35OCLIFEA.W2GAXFHK7X3EY2CAE4DQ3L2PJILOTPQWHONL4WDUZBA27AKHKQCQ
AUTO_ENROLLMENT_GATEWAY_IDS=kerlink-building-1